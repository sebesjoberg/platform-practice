# {{ ansible_managed }} (role nginx)
# The complete configuration, owned by the role: Ansible validates this file with nginx -t before
# it replaces /etc/nginx/nginx.conf. Include paths are absolute because with -c nginx resolves
# relative paths against the directory of the checked file (a temporary one during validation).
user www-data;
worker_processes auto;
pid /run/nginx.pid;
error_log /var/log/nginx/error.log;
include /etc/nginx/modules-enabled/*.conf;

events {
    worker_connections {{ nginx_worker_connections }};
}

http {
    sendfile on;
    tcp_nopush on;
    types_hash_max_size 2048;
    server_tokens off;

    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    access_log /var/log/nginx/access.log;
    gzip on;

    server {
        # Plain HTTP stays on: the load balancer (an-10) checks and forwards on port 80 inside
        # the network.
        listen 80 default_server;
{% if nginx_tls %}
        listen 443 ssl default_server;
        ssl_certificate {{ nginx_tls_dir }}/{{ nginx_tls_name }}.crt;
        ssl_certificate_key {{ nginx_tls_dir }}/{{ nginx_tls_name }}.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers off;
        ssl_session_cache shared:TLS:10m;
        ssl_session_timeout 1d;
        ssl_session_tickets off;
{% endif %}
        server_name _;
        root {{ nginx_root }};
        index index.html;

        location / {
            try_files $uri $uri/ =404;
        }
    }
}
