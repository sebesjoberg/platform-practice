---
# yamllint for ansible/: the defaults, with the settings ansible-lint requires of a custom config
# (it refuses an incompatible one).
extends: default

ignore: |
  .venv/
  collections/ansible_collections/
  .ansible/

rules:
  line-length:
    max: 160
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
